# HoneyCow runtime configuration.
# Copy to .env for local overrides; never commit .env.

# Required. Public IPv4 of the honeycow VPS. Used as NS glue (A glue for
# every name in HONEY_NS_HOSTS — all aliases share one IP, since one host
# answers for all of them) and as the default sinkhole target for synthesized
# A answers.
HONEY_PUBLIC_A=203.0.113.10

# Optional. Public IPv6. If empty, AAAA answers return NODATA and the v6
# listeners are disabled. Used as AAAA glue and default sinkhole for v6.
# HONEY_PUBLIC_AAAA=2001:db8::10

# Sinkhole target override. Defaults to HONEY_PUBLIC_A / HONEY_PUBLIC_AAAA.
# Override if you want synthesized A answers to point somewhere other than
# this server.
# HONEY_SINKHOLE_A=203.0.113.10
# HONEY_SINKHOLE_AAAA=2001:db8::10

# Identity baked into every bluffed response. Replace with your own domain
# before deploying; RFC 2606 placeholders are fine for local testing but
# resolvers won't follow them back to a real server.
HONEY_DOMAIN=example.com.
HONEY_NS_HOSTS=ns1.example.com,ns2.example.com
HONEY_ABUSE_EMAIL=abuse@example.com
HONEY_ABUSE_URL=https://example.com
HONEY_TXT_CALLING_CARD="honeycow: this is not the cow you are looking for. a polite ns squatter. https://example.com abuse@example.com"

# Optional. Themed bluff for the classic `version.bind. TXT CH` scanner
# fingerprint query. Empty (default) means version.bind gets the same
# calling-card TXT as any other CH-class TXT query. Set this to give it
# its own personality. Suggestion:
# HONEY_VERSION_BIND_TXT="BIND 9.20 fl.oz. of pure local example.com"

# Production deploy (docker-compose.prod.yml) reuses HONEY_PUBLIC_A and
# HONEY_PUBLIC_AAAA above for the host port bindings — one source of
# truth. No additional variables needed for prod.

# Event log path inside the container.
HONEY_LOG=/var/log/honeycow/events.jsonl

# Exemption list (bind-mounted from the repo into the container).
HONEY_EXEMPTION_FILE=/etc/honeycow/exemptions.txt

# Static HTTP closer page (baked into the image).
HONEY_STATIC_INDEX=/app/static/index.html

# Bind addresses for DNS. Set HONEY_BIND_V6= to disable IPv6 binding.
HONEY_BIND_V4=0.0.0.0
HONEY_BIND_V6=::

# Bind addresses for HTTP closer. Default to HONEY_BIND_V4 / HONEY_BIND_V6 so
# the closer is publicly reachable. Set to 127.0.0.1 / ::1 when running the
# Caddy overlay so Caddy owns the public ports and reverse-proxies the closer.
# HONEY_HTTP_BIND_V4=127.0.0.1
# HONEY_HTTP_BIND_V6=::1

# Listen ports. Use 53/80 in production and high ports for local testing.
HONEY_PORT=53
HONEY_HTTP_PORT=80

# TCP guardrails.
HONEY_TCP_TIMEOUT=5
HONEY_TCP_MAX_CONNS=50
HONEY_TCP_ACCEPT_BACKLOG=100
HONEY_TCP_MAX_QUERIES_PER_CONN=32

# UDP response rate limiting.
HONEY_UDP_RATELIMIT_ENABLED=1
HONEY_UDP_RATELIMIT_RATE=200
HONEY_UDP_RATELIMIT_BURST=400

# Outbound byte budget: hard cap on total response bytes over a rolling
# window. Defense-in-depth circuit breaker against amplification
# participation. When exhausted, UDP responses become TC=1 + empty
# sections, TCP responses become REFUSED, HTTP responses become a tiny
# 503. Normal traffic (~few MB/day) leaves ~2000x headroom under the
# defaults; trip is essentially impossible during legitimate operation.
HONEY_OUTBOUND_BUDGET_BYTES=100000000
HONEY_OUTBOUND_BUDGET_WINDOW=3600

# Herd vantage-point identity. Each cow in a multi-VPS herd sets a unique
# short id (e.g. ams-01, nyc-02) which is stamped onto every emitted event
# as `site_id`, so per-cow digests stay attributable once merged at the
# collector. Leave empty (or unset) on a single-instance deploy — when
# empty the field is omitted entirely and logs are unchanged.
HONEY_SITE_ID=

# Container image to run. Unset on the flagship -> honeycow:latest, built
# locally by `make up` / `make up-prod`. A herd cow pins this to an immutable
# GHCR tag so it pulls the prebuilt image instead of building on a throwaway
# VPS, e.g. HONEY_IMAGE=ghcr.io/mclose/honeycow:sha-abc1234
HONEY_IMAGE=
