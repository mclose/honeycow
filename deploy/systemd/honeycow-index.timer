# Fires the index refresh once a day. Persistent=true so a run missed while
# the host was off is caught up on next boot. Randomized delay keeps it off a
# round-number minute (politeness to the honeycow VPS). See the .service for
# install steps.
[Unit]
Description=HoneyCow: daily SQLite index refresh
Documentation=file:%h/projects/honeycow/docs/deployment.md

[Timer]
OnCalendar=*-*-* 05:30:00
RandomizedDelaySec=900
Persistent=true

[Install]
WantedBy=timers.target
